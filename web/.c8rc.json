{
  "all": true,
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/contracts/**",
    "src/**/*.d.ts",
    "src/**/__mocks__/**",
    "src/**/types.ts",
    "src/**/*.config.ts",
    "src/generated/**",
    "tests/**"
  ],
  "reporter": [
    "text",
    "json",
    "json-summary",
    "lcov",
    "html"
  ],
  "reports-dir": "./coverage-integration",
  "temp-directory": "./.v8-coverage"
}
