generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                String               @id @default(cuid())
  email             String               @unique
  password          String
  name              String
  role              AdminRole            @default(OPERATIONS_ADMIN)
  isActive          Boolean              @default(true)
  lastLoginAt       DateTime?
  // R6 — legacy `permissions String[]` column. Will be dropped in migration
  // 20260806000000_drop_admin_legacy_permissions after 1-week staging soak
  // (ends 2026-08-06). Until then, kept for backward compatibility — new
  // writers go to `AdminHasPermission`; old writers/readers still use this.
  //
  // DEEP-AUDIT D-P2-6 (2026-08-08): the column is REVERTED to its
  // pre-D-P2-6 state. The 50+ file migration across the admin and
  // rider modules to use AdminHasPermission exclusively was out of
  // scope for this audit pass. The drop migration is now tracked as
  // a separate follow-up (D-P2-6-backfill) that requires coordinated
  // changes in every site that reads Admin.permissions.
  permissions       String[]             @default([])
  tokenVersion      Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sessions          AdminSession[]
  backupJobs        BackupJob[]
  hasPermissions    AdminHasPermission[]
  // DEEP-AUDIT D-P2-8 (2026-08-08): back-relations for the new
  // Incident.assignedToId / resolvedById FKs. The relation names
  // disambiguate "assigned" vs "resolved" so the same admin can be
  // the assigner on one incident and the resolver on another.
  incidentsAssigned Incident[]           @relation("IncidentAssignedAdmin")
  incidentsResolved Incident[]           @relation("IncidentResolvedByAdmin")
  // P1: back-relation for SupportTicket.assignedToId (mirrors incidents).
  ticketsAssigned SupportTicket[]        @relation("TicketAssignedAdmin")

  @@index([role])
  @@index([email])
  @@map("admins")
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminHasPermission {
  id         String   @id @default(cuid())
  adminId    String
  permission String
  createdAt  DateTime @default(now())
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, permission])
  @@index([adminId])
  @@index([permission])
  @@map("admin_has_permissions")
}

model RolePermission {
  id         String   @id @default(cuid())
  role       String
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
  @@index([permission])
  @@map("role_permissions")
}

model Hub {
  id              String       @id @default(cuid())
  name            String
  location        String?
  city            String?
  isActive        Boolean      @default(true)
  // P1.5 (2026-08-05 rentals/vehicles/hubs audit): soft delete — a deleted
  // hub is hidden from every read path (deletedAt: null) but the row and its
  // audit trail survive for compliance. Hard deletes are gone from the API.
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  vehicles        Vehicle[]
  // PR-P3.2: back-relation for Rider.pickupHubRef
  pickupHubRiders Rider[]      @relation("RiderPickupHub")
  // P1.8 (2026-08-05 rentals/vehicles/hubs audit): hub-scoped team leaders.
  teamLeaders     TeamLeader[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("hubs")
}

model Vehicle {
  id             String          @id @default(cuid())
  vehicleId      String          @unique
  vehicleNumber  String          @unique
  model          String
  licensePlate   String?
  batteryLevel   Int             @default(100)
  batteryPartner String?
  status         VehicleStatus   @default(AVAILABLE)
  hubId          String
  assignedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  // DEEP-AUDIT D-P2-9 (2026-08-08): currentRiderId is the explicit
  // "who is currently using this vehicle" pointer. Previously a
  // vehicle's current rider was derived from `Rider.vehicleId`, which
  // meant `db.vehicle.findMany({ include: { riders: true } })`
  // returned ALL historical riders, not just the active one. The
  // FK is nullable + SetNull so deleting a rider never cascades to
  // delete their assigned vehicle (consistent with Rider.vehicleId).
  // Migration backfills from active RentalLease.riderId.
  currentRiderId String?
  currentRider   Rider?          @relation("VehicleCurrentRider", fields: [currentRiderId], references: [id], onDelete: SetNull)
  incidents      Incident[]
  leases         RentalLease[]   @relation("VehicleLeases")
  riders         Rider[]
  tickets        SupportTicket[] @relation("VehicleTickets")
  hub            Hub             @relation(fields: [hubId], references: [id], onDelete: Restrict)
  returns        VehicleReturn[] @relation("VehicleReturns")

  @@index([status])
  @@index([hubId])
  @@index([vehicleId])
  @@index([hubId, status])
  @@index([currentRiderId])
  // P1: soft-delete filter is injected into every vehicle read (db.ts) —
  // without this index those reads seq-scan.
  @@index([deletedAt])
  @@map("vehicles")
}

model Shift {
  id          String        @id @default(cuid())
  name        String
  startTime   String
  endTime     String
  parts       String?
  maxBookings Int           @default(5)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  leases      RentalLease[]

  // P1: soft-delete filter index (see vehicles).
  @@index([deletedAt])
  @@map("shifts")
}

/// RentalPlan represents a recurring subscription. 
/// The `durationDays` represents the billing cycle length, which is strictly hardcoded
/// based on `type` (DAILY = 1, WEEKLY = 7, MONTHLY = 30) in the backend use-cases.
model RentalPlan {
  id                     String         @id @default(cuid())
  name                   String
  type                   RentalPlanType
  priceInPaise           Int
  durationDays           Int
  description            String?
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?
  securityDepositInPaise Int            @default(0)
  additionalInfo         String?
  isSecurityRefundable   Boolean        @default(true)
  refundableAfterDays    Int?
  // PR-P3.2: back-relation for Rider.currentPlanRef
  currentPlanRiders      Rider[]        @relation("RiderCurrentPlan")

  // P1: soft-delete filter index (see vehicles).
  @@index([deletedAt])
  @@map("rental_plans")
}

model Rider {
  id                      String                 @id @default(cuid())
  serialNumber            Int                    @default(autoincrement())
  riderId                 String                 @unique
  phone                   String                 @unique
  fullName                String?
  email                   String?
  fatherName              String?
  motherName              String?
  dob                     String?
  currentAddress          String?
  tokenVersion            Int                    @default(1)
  intent                  String?
  // PR-K.3 — legacy `lifecycleStatus` enum column. Will be dropped in
  // migration 20260806020000_drop_rider_legacy_lifecycle_status after the
  // 1-week staging soak (ends 2026-08-06). Until then, kept for backfill;
  // new readers/writers prefer `lifecycleStage` (5-value enum) when set.
  //
  // DEEP-AUDIT D-P2-5 (2026-08-08): REVERTED. The 50+ file migration
  // to read lifecycleStage exclusively is out of scope for this audit
  // pass. The drop is now tracked as D-P2-5-backfill.
  lifecycleStatus         RiderLifecycleStatus   @default(NEW)
  lifecycleStage          RiderLifecycleStage?   @default(NEW)
  vehicleId               String?
  deliveryId              String?
  assignedVehicle         String?
  // PR-J — legacy `pickupHub` string column. Will be dropped in migration
  // 20260806010000_drop_rider_legacy_string_columns after the staging soak.
  // Until then, kept for backfill gap handling.
  //
  // DEEP-AUDIT D-P2-4 (2026-08-08): REVERTED. The 50+ file migration
  // to read from the FKs exclusively is out of scope for this audit
  // pass. The drop is now tracked as D-P2-4-backfill and requires
  // coordinated changes in every reader.
  pickupHub               String?
  // PR-P3.2: FK column next to the legacy `pickupHub` string. Backfilled from
  // Hub.id or Hub.name. NULL when the legacy value doesn't match anything.
  pickupHubId             String?
  // PR-J — legacy `currentPlan` string column. Will be dropped after soak.
  currentPlan             String?
  // PR-P3.2: FK column next to the legacy `currentPlan` string. Backfilled
  // from RentalPlan.id or RentalPlan.name. NULL when no match.
  currentPlanId           String?
  planStartDate           DateTime?
  planEndDate             DateTime?
  advanceRentPaid         Boolean                @default(false)
  preferredShift          String?
  // PR-J — legacy `teamLeader` string column. Will be dropped after soak.
  teamLeader              String?
  // PR-P3.2: FK column next to the legacy `teamLeader` string. Verified
  // ID-only in all writers, so backfill is a single ID lookup.
  teamLeaderId            String?
  emergencyContact        String?
  referralCode            String                 @unique
  // P1: referral chain was an unenforced free-text column (typos created
  // dangling referrals). Self-FK to the referrer's referralCode; deleting a
  // referrer nulls the link (history keeps the referee row).
  referredBy              String?
  referredByRider         Rider?                 @relation("ReferralChain", fields: [referredBy], references: [referralCode], onDelete: SetNull)
  referralsGiven          Rider[]                @relation("ReferralChain")
  locationGranted         Boolean                @default(false)
  batteryGranted          Boolean                @default(false)
  contactsGranted         Boolean                @default(false)
  callLogsGranted         Boolean                @default(false)
  micGranted              Boolean                @default(false)
  cameraGranted           Boolean                @default(false)
  phoneGranted            Boolean                @default(false)
  pickedUpAt              DateTime?
  registrationDoneAt      DateTime?
  depositDoneAt           DateTime?
  kycDoneAt               DateTime?
  planDoneAt              DateTime?
  fcmToken                String?
  isAdminLocked           Boolean                @default(false)
  lockPasswordHash        String?
  isUninstallBlocked      Boolean                @default(true)
  isLocationMandatory     Boolean                @default(true)
  isAppsControlRestricted Boolean                @default(true)
  deviceAdminGranted      Boolean                @default(false)
  displayOverlayGranted   Boolean                @default(false)
  lastDeviceViolationAt   DateTime?
  deviceViolationCount    Int                    @default(0)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  deletedAt               DateTime?
  // PR-3 (2026-08-07 verification report, Section 2): rider-initiated
  // GDPR/DPDP deletion request markers. Populated by POST
  // /api/rider/account/delete-request; admin data-deletion screen can
  // surface these to operators.
  deletionRequestedAt     DateTime?
  deletionRequestReason   String?
  // PR-2026-08-16: set by data-deletion-purge.job.ts once the 7-day appeal
  // window passes and the PII is destroyed. The admin data-deletion queue
  // uses it to distinguish "purged" (purgedAt set) from "pending"
  // (deletedAt set, purgedAt null).
  purgedAt                DateTime?
  // LANGUAGE-AUDIT (2026-08-16) #6: rider's chosen language as a
  // BCP-47 language tag (`en`, `hi`). NULL means "follow system".
  // Mirrored on every `LocaleNotifier.setLocale()` from the mobile
  // app via PUT /api/rider/profile. The shared-prefs copy on the
  // device is the source of truth for offline startup; the server
  // copy is the source of truth for cross-device sync.
  preferredLocale         String?
  requiresHigherDeposit   Boolean                @default(false)
  currentPlanPrice        Int?
  pickupPhotoFront        String?
  pickupPhotoBack         String?
  pickupPhotoLeft         String?
  pickupPhotoRight        String?
  pickupPhotoWithVehicle  String?
  lastKnownLat            Float?
  lastKnownLng            Float?
  lastLocationAt          DateTime?
  batteryLevel            Int                    @default(100)
  planRejectionReason     String?
  announcements           AnnouncementDelivery[]
  depositRecord           DepositRecord?
  deviceViolations        DeviceViolation[]
  guarantor               Guarantor?
  incidents               Incident[]
  kycProfile              KycProfile?
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  permissions             RiderPermission[]
  adminLock               RiderAdminLock?
  pickupPhoto             RiderPickupPhoto?
  leases                  RentalLease[]
  vehicle                 Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  // DEEP-AUDIT D-P2-9: back-relation for Vehicle.currentRiderId. The
  // name `currentVehicleRider` disambiguates from the existing
  // `vehicle` field (which is the rider's historical/assigned
  // vehicle via the Rider.vehicleId string column).
  currentVehicleRider     Vehicle[]              @relation("VehicleCurrentRider")
  // PR-P3.2: FK columns added next to the legacy string columns. The legacy
  // columns are kept for backward compatibility (PR-P3.3 will drop them after
  // 1-week staging soak). Each FK uses ON DELETE SET NULL to match the legacy
  // column's nullability semantics.
  pickupHubRef            Hub?                   @relation("RiderPickupHub", fields: [pickupHubId], references: [id], onDelete: SetNull, map: "riders_pickupHubId_fkey")
  currentPlanRef          RentalPlan?            @relation("RiderCurrentPlan", fields: [currentPlanId], references: [id], onDelete: SetNull, map: "riders_currentPlanId_fkey")
  teamLeaderRef           TeamLeader?            @relation("RiderTeamLeader", fields: [teamLeaderId], references: [id], onDelete: SetNull, map: "riders_teamLeaderId_fkey")
  earnings                RiderEarning[]
  score                   RiderScore?
  tickets                 SupportTicket[]
  trafficFines            TrafficFine[]
  transactions            Transaction[]
  deviceCallLogs          UserCallLog[]
  deviceContacts          UserContact[]
  deviceLocations         UserLocation[]
  vehicleReturns          VehicleReturn[]
  wallet                  Wallet?
  walletLedger            WalletLedger[]
  rewards                 Reward[]
  consents                Consent[]
  // P1: back-relation for SyncQueue.riderId FK.
  syncQueue               SyncQueue[]

  @@index([phone])
  @@index([riderId])
  @@index([referralCode])
  @@index([referredBy])
  @@index([pickupHubId])
  @@index([currentPlanId])
  @@index([teamLeaderId])
  @@index([createdAt])
  @@index([updatedAt])
  // P1: hot worker/admin filters (lifecycleStatus sweeps) and the
  // soft-delete predicate injected into every rider read had no indexes.
  @@index([lifecycleStatus])
  @@index([deletedAt])
  // P1: search-by-email seq-scanned (non-unique: dupes allowed, index only).
  @@index([email])
  @@map("riders")
}

model Consent {
  id            String   @id @default(cuid())
  riderId       String
  consentType   String // 'LOCATION' | 'CONTACTS' | 'CALL_LOGS'
  granted       Boolean
  policyVersion String   @default("public-beta-v1")
  source        String   @default("DEVICE") // 'DEVICE' | 'SERVER'
  createdAt     DateTime @default(now())
  // P1: forensics/purge ordering previously relied on createdAt only.
  // Nullable so existing rows migrate without a backfill.
  updatedAt     DateTime? @updatedAt

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([riderId, consentType])
  @@map("consents")
}

model VehicleReturn {
  id                  String              @id @default(cuid())
  riderId             String
  vehicleId           String
  status              VehicleReturnStatus @default(SUBMITTED)
  photoFront          String?
  photoBack           String?
  photoLeft           String?
  photoRight          String?
  photoSpeedometer    String?
  latitude            Float?
  longitude           Float?
  reason              String?
  rejectionReason     String?
  endOdometer         Int?
  damageAmountInPaise Int?
  isFeeWaived         Boolean             @default(false)
  waiverReason        String?
  waivedBy            String?
  inspectedBy         String?
  inspectedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  rider               Rider               @relation(fields: [riderId], references: [id], onDelete: Cascade)
  // P1: was Cascade — deleting a vehicle wiped its leases/tickets/returns
  // (operational + financial history). Restrict like Vehicle.hubId: retire
  // the vehicle (soft-delete) instead; raw-SQL hard deletes are blocked
  // while history references it.
  vehicle             Vehicle             @relation("VehicleReturns", fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([riderId])
  @@index([vehicleId])
  @@index([status])
  @@index([riderId, status])
  @@map("vehicle_returns")
}

model KycProfile {
  id              String    @id @default(cuid())
  riderId         String    @unique
  status          KycStatus @default(PENDING)
  profilePhoto    String?
  riderPhoto      String?
  signature       String?
  aadhaarFront    String?
  aadhaarBack     String?
  aadhaarNumber   String?
  panCard         String?
  panNumber       String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  rejectionReason String?
  // NET-005 (audit batch 20, 2026-09-02): expiresAt is set on approval
  // (kyc.repository.ts approve path) and swept daily by
  // kyc-expiry.job.ts. APPROVED rows with expiresAt < now() transition
  // to EXPIRED. The 365-day window matches AuditLog retention for
  // kyc.* actions (web/src/lib/audit-log.ts:4-10).
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  editableFields  String[]
  rider           Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([riderId])
  @@index([status, riderId])
  @@index([updatedAt])
  @@index([status, expiresAt])
  @@map("kyc_profiles")
}

model Guarantor {
  id           String          @id @default(cuid())
  riderId      String          @unique
  status       GuarantorStatus @default(PENDING)
  name         String?
  relation     String?
  dob          String?
  phone        String?
  aadhaarFront String?
  aadhaarBack  String?
  pan          String?
  video        String?
  signature    String?
  address      String?
  photo        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  fatherName   String?
  motherName   String?
  rider        Rider           @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([status])
  // P1: soft-delete filter index (see vehicles).
  @@index([deletedAt])
  @@map("guarantors")
}

model Wallet {
  id                     String         @id @default(cuid())
  riderId                String         @unique
  balanceInPaise         Int            @default(0)
  securityDepositInPaise Int            @default(0)
  depositStatus          DepositStatus  @default(NOT_SUBMITTED)
  paymentStreak          Int            @default(0)
  version                Int            @default(1)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  rider                  Rider          @relation(fields: [riderId], references: [id], onDelete: Restrict)
  ledgerEntries          WalletLedger[]

  @@index([riderId])
  @@index([depositStatus])
  @@map("wallets")
}

model WalletLedger {
  id             String          @id @default(cuid())
  walletId       String
  riderId        String
  transactionId  String?         @map("txnId")
  entryType      LedgerEntryType
  category       LedgerCategory
  amountInPaise  Int
  balanceAfter   Int
  idempotencyKey String?         @unique
  note           String?
  actorId        String?
  createdAt      DateTime        @default(now())
  rider          Rider           @relation(fields: [riderId], references: [id], onDelete: Restrict)
  txn            Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([riderId])
  @@index([transactionId])
  @@index([category])
  @@index([createdAt])
  @@index([riderId, createdAt])
  @@map("wallet_ledgers")
}

model DepositRecord {
  id                    String        @id @default(cuid())
  riderId               String        @unique
  transactionId         String?       @unique
  amountInPaise         Int           @default(0)
  status                DepositStatus @default(PENDING)
  paidAt                DateTime?
  approvedAt            DateTime?
  approvedBy            String?
  rejectedAt            DateTime?
  rejectedBy            String?
  rejectionReason       String?
  refundedAt            DateTime?
  refundedBy            String?
  refundedAmountInPaise Int?
  forfeitedAt           DateTime?
  forfeitedBy           String?
  forfeitReason         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  rider                 Rider         @relation(fields: [riderId], references: [id], onDelete: Restrict)
  transaction           Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([riderId])
  @@map("deposit_records")
}

model RentalLease {
  id                String       @id @default(cuid())
  vehicleId         String
  riderId           String
  shiftId           String
  leaseDate         String
  startTime         String
  endTime           String?
  status            RentalStatus @default(BOOKED)
  basePriceInPaise  Int
  finalPriceInPaise Int
  startOdometer     Int?
  startBatteryPct   Int?
  // PR-76: rent auto-debit period tracking. A lease is charged
  // for its `finalPriceInPaise` once per `durationDays`-shaped
  // period; `nextRentDueAt` advances to the next period boundary
  // after each successful auto-debit, so a 7-day tenant is
  // debited exactly once across 7 day-ticks, not 7 times.
  nextRentDueAt     DateTime?
  lastPaidAt        DateTime?
  periodNo          Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  rider             Rider        @relation(fields: [riderId], references: [id], onDelete: Cascade)
  shift             Shift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  // P1: was Cascade (see VehicleReturns note) — lease history survives the vehicle.
  vehicle           Vehicle      @relation("VehicleLeases", fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, shiftId, leaseDate])
  @@index([riderId, leaseDate])
  @@index([vehicleId, leaseDate])
  @@index([status])
  @@index([riderId, status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([nextRentDueAt])
  @@map("rental_leases")
}

model Transaction {
  id              String                 @id @default(cuid())
  riderId         String
  type            TransactionType
  amountInPaise   Int
  purpose         TransactionPurpose
  // H6-2026-08-13: audience discriminator. Lets the rider history
  // endpoint filter to user-initiated flows (top-ups + deposits)
  // without having to enumerate the 7 system-only purposes
  // (RENT_PAYMENT, REWARD, REFUND, REVERSAL, ADMIN_ADJUSTMENT,
  // FORFEITURE, ONBOARDING). Set at row-creation time based on
  // purpose; default SYSTEM is the safe choice for existing rows.
  audience        TransactionAudience    @default(SYSTEM)
  // DEEP-AUDIT D-P2-7 (2026-08-08): clarified the relationship to
  // WalletLedger.idempotencyKey. A single topup creates one Transaction
  // row and one WalletLedger row; each carries an idempotency key.
  // Transaction.idempotencyKey is the REQUEST-level key (the client
  // builds it once when submitting the topup). WalletLedger carries
  // the same value (the request key doubles as the event key) so a
  // replay of the same request cannot double-credit the wallet.
  reason          String?
  method          String?
  status          TransactionStatus      @default(PENDING)
  upiRef          String?
  receipt         String?
  proofUrl        String?
  remark          String?
  description     String?
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  idempotencyKey  String?                @unique
  // P1: reversal chain was an unenforced free-text column. Self-FK makes
  // REVERSED status traceable and blocks dangling reversal links.
  reversedTxnId   String?
  createdAt       DateTime               @default(now())
  depositRecord   DepositRecord?
  rider           Rider                  @relation(fields: [riderId], references: [id], onDelete: Restrict)
  reversedTxn     Transaction?           @relation("ReversalChain", fields: [reversedTxnId], references: [id], onDelete: SetNull)
  reversals       Transaction[]          @relation("ReversalChain")
  breakdowns      TransactionBreakdown[]
  ledgerEntries   WalletLedger[]

  @@index([status])
  @@index([riderId])
  @@index([purpose])
  @@index([createdAt])
  @@index([idempotencyKey])
  @@index([riderId, status])
  @@index([riderId, createdAt])
  // H6-2026-08-13: index for rider history with audience filter
  @@index([riderId, audience, createdAt])
