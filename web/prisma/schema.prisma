model OutboxEvent {
  id          String            @id @default(cuid())
  eventType   String
  payload     String
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  maxAttempts Int               @default(3)
  error       String?
  createdAt   DateTime          @default(now())
  processedAt DateTime?
  /// Phase 3.4: @updatedAt is managed by Prisma. The reaper uses
  /// it to find rows that have been stuck in PROCESSING for more
  /// than the reaper cutoff.
  updatedAt   DateTime          @updatedAt
  /// Phase 3.4: readyAt is the earliest time the job may be claimed
  /// after a failure (exponential backoff). NULL = eligible now.
  /// See prisma/migrations/20260626000000_add_outbox_readyAt/.
  readyAt     DateTime?
  /// PR-75: priority splits the queue into 'interactive' (rent-due
  /// SMS, referral rewards, FCM dispatch, daily engagement) vs
  /// 'background' (telemetry cleanup, audit cleanup, scheduled
  /// backup, wallet reconciliation, etc.). The worker orchestrator
  /// polls interactive first; background workers are gated to run
  /// only when no interactive events are PENDING. Default is
  /// 'background' so existing event types and code paths keep their
  /// old behavior. See AUDIT_BACKEND_2026-08-03.md §2.A.N2 and
  /// AUDIT_FIX_PLAN_2026-08-03.md PR-75.
  priority    String            @default("background")

  @@index([eventType])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, eventType, readyAt])
  @@index([status, updatedAt])
  /// PR-75: composite index for the worker's "oldest interactive
  /// PENDING event" claim. The (priority, status, createdAt) order
  /// is intentional — it matches the worker's WHERE clause
  /// (`priority = ? AND status = 'PENDING' ORDER BY createdAt ASC`).
  @@index([priority, status, createdAt])
  @@map("outbox_events")
}

