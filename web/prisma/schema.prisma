generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String               @id @default(cuid())
  email          String               @unique
  password       String
  name           String
  role           AdminRole            @default(OPERATIONS_ADMIN)
  isActive       Boolean              @default(true)
  lastLoginAt    DateTime?
  // R6 — legacy `permissions String[]` column. Will be dropped in migration
  // 20260806000000_drop_admin_legacy_permissions after 1-week staging soak
  // (ends 2026-08-06). Until then, kept for backward compatibility — new
  // writers go to `AdminHasPermission`; old writers/readers still use this.
  permissions    String[]             @default([])
  tokenVersion   Int                  @default(1)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sessions       AdminSession[]
  backupJobs     BackupJob[]
  hasPermissions AdminHasPermission[]

  @@index([role])
  @@index([email])
  @@map("admins")
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminHasPermission {
  id         String   @id @default(cuid())
  adminId    String
  permission String
  createdAt  DateTime @default(now())
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, permission])
  @@index([adminId])
  @@index([permission])
  @@map("admin_has_permissions")
}

model RolePermission {
  id         String   @id @default(cuid())
  role       String
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
  @@index([permission])
  @@map("role_permissions")
}

model Hub {
  id              String    @id @default(cuid())
  name            String
  location        String?
  city            String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  vehicles        Vehicle[]
  // PR-P3.2: back-relation for Rider.pickupHubRef
  pickupHubRiders Rider[]   @relation("RiderPickupHub")

  @@index([isActive])
  @@map("hubs")
}

model Vehicle {
  id             String          @id @default(cuid())
  vehicleId      String          @unique
  vehicleNumber  String          @unique
  model          String
  licensePlate   String?
  batteryLevel   Int             @default(100)
  batteryPartner String?
  status         VehicleStatus   @default(AVAILABLE)
  hubId          String
  assignedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  incidents      Incident[]
  leases         RentalLease[]   @relation("VehicleLeases")
  riders         Rider[]
  tickets        SupportTicket[] @relation("VehicleTickets")
  hub            Hub             @relation(fields: [hubId], references: [id], onDelete: Restrict)
  returns        VehicleReturn[] @relation("VehicleReturns")

  @@index([status])
  @@index([hubId])
  @@index([vehicleId])
  @@index([hubId, status])
  @@map("vehicles")
}

model Shift {
  id          String        @id @default(cuid())
  name        String
  startTime   String
  endTime     String
  parts       String?
  maxBookings Int           @default(5)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  leases      RentalLease[]

  @@map("shifts")
}

/// RentalPlan represents a recurring subscription. 
/// The `durationDays` represents the billing cycle length, which is strictly hardcoded
/// based on `type` (DAILY = 1, WEEKLY = 7, MONTHLY = 30) in the backend use-cases.
model RentalPlan {
  id                     String         @id @default(cuid())
  name                   String
  type                   RentalPlanType
  priceInPaise           Int
  durationDays           Int
  description            String?
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?
  securityDepositInPaise Int            @default(0)
  additionalInfo         String?
  isSecurityRefundable   Boolean        @default(true)
  refundableAfterDays    Int?
  // PR-P3.2: back-relation for Rider.currentPlanRef
  currentPlanRiders      Rider[]        @relation("RiderCurrentPlan")

  @@map("rental_plans")
}

model Rider {
  id                      String                 @id @default(cuid())
  serialNumber            Int                    @default(autoincrement())
  riderId                 String                 @unique
  phone                   String                 @unique
  fullName                String?
  email                   String?
  fatherName              String?
  motherName              String?
  dob                     String?
  currentAddress          String?
  tokenVersion            Int                    @default(1)
  intent                  String?
  // PR-K.3 — legacy `lifecycleStatus` enum column. Will be dropped in
  // migration 20260806020000_drop_rider_legacy_lifecycle_status after the
  // 1-week staging soak (ends 2026-08-06). Until then, kept for backfill;
  // new readers/writers prefer `lifecycleStage` (5-value enum) when set.
  lifecycleStatus         RiderLifecycleStatus   @default(NEW)
  lifecycleStage          RiderLifecycleStage?   @default(NEW)
  vehicleId               String?
  deliveryId              String?
  assignedVehicle         String?
  // PR-J — legacy `pickupHub` string column. Will be dropped in migration
  // 20260806010000_drop_rider_legacy_string_columns after the staging soak.
  // Until then, kept for backfill gap handling.
  pickupHub               String?
  // PR-P3.2: FK column next to the legacy `pickupHub` string. Backfilled from
  // Hub.id or Hub.name. NULL when the legacy value doesn't match anything.
  pickupHubId             String?
  // PR-J — legacy `currentPlan` string column. Will be dropped after soak.
  currentPlan             String?
  // PR-P3.2: FK column next to the legacy `currentPlan` string. Backfilled
  // from RentalPlan.id or RentalPlan.name. NULL when no match.
  currentPlanId           String?
  planStartDate           DateTime?
  planEndDate             DateTime?
  advanceRentPaid         Boolean                @default(false)
  preferredShift          String?
  // PR-J — legacy `teamLeader` string column. Will be dropped after soak.
  teamLeader              String?
  // PR-P3.2: FK column next to the legacy `teamLeader` string. Verified
  // ID-only in all writers, so backfill is a single ID lookup.
  teamLeaderId            String?
  emergencyContact        String?
  referralCode            String                 @unique
  referredBy              String?
  locationGranted         Boolean                @default(false)
  batteryGranted          Boolean                @default(false)
  contactsGranted         Boolean                @default(false)
  callLogsGranted         Boolean                @default(false)
  micGranted              Boolean                @default(false)
  cameraGranted           Boolean                @default(false)
  phoneGranted            Boolean                @default(false)
  pickedUpAt              DateTime?
  registrationDoneAt      DateTime?
  depositDoneAt           DateTime?
  kycDoneAt               DateTime?
  planDoneAt              DateTime?
  fcmToken                String?
  isAdminLocked           Boolean                @default(false)
  lockPasswordHash        String?
  isUninstallBlocked      Boolean                @default(true)
  isLocationMandatory     Boolean                @default(true)
  isAppsControlRestricted Boolean                @default(true)
  deviceAdminGranted      Boolean                @default(false)
  displayOverlayGranted   Boolean                @default(false)
  lastDeviceViolationAt   DateTime?
  deviceViolationCount    Int                    @default(0)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  deletedAt               DateTime?
  currentPlanPrice        Int?
  pickupPhotoFront        String?
  pickupPhotoBack         String?
  pickupPhotoLeft         String?
  pickupPhotoRight        String?
  pickupPhotoWithVehicle  String?
  lastKnownLat            Float?
  lastKnownLng            Float?
  lastLocationAt          DateTime?
  batteryLevel            Int                    @default(100)
  planRejectionReason     String?
  announcements           AnnouncementDelivery[]
  depositRecord           DepositRecord?
  deviceViolations        DeviceViolation[]
  guarantor               Guarantor?
  incidents               Incident[]
  kycProfile              KycProfile?
  notifications           Notification[]
  permissions             RiderPermission[]
  adminLock               RiderAdminLock?
  pickupPhoto             RiderPickupPhoto?
  leases                  RentalLease[]
  vehicle                 Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  // PR-P3.2: FK columns added next to the legacy string columns. The legacy
  // columns are kept for backward compatibility (PR-P3.3 will drop them after
  // 1-week staging soak). Each FK uses ON DELETE SET NULL to match the legacy
  // column's nullability semantics.
  pickupHubRef            Hub?                   @relation("RiderPickupHub", fields: [pickupHubId], references: [id], onDelete: SetNull, map: "riders_pickupHubId_fkey")
  currentPlanRef          RentalPlan?            @relation("RiderCurrentPlan", fields: [currentPlanId], references: [id], onDelete: SetNull, map: "riders_currentPlanId_fkey")
  teamLeaderRef           TeamLeader?            @relation("RiderTeamLeader", fields: [teamLeaderId], references: [id], onDelete: SetNull, map: "riders_teamLeaderId_fkey")
  earnings                RiderEarning[]
  score                   RiderScore?
  tickets                 SupportTicket[]
  trafficFines            TrafficFine[]
  transactions            Transaction[]
  deviceCallLogs          UserCallLog[]
  deviceContacts          UserContact[]
  deviceLocations         UserLocation[]
  vehicleReturns          VehicleReturn[]
  wallet                  Wallet?
  walletLedger            WalletLedger[]
  rewards                 Reward[]

  @@index([lifecycleStatus])
  @@index([phone])
  @@index([riderId])
  @@index([referralCode])
  @@index([referredBy])
  @@index([teamLeader])
  @@index([phone, lifecycleStatus])
  @@index([updatedAt])
  @@index([lifecycleStatus, updatedAt])
  @@map("riders")
}

model VehicleReturn {
  id                  String              @id @default(cuid())
  riderId             String
  vehicleId           String
  status              VehicleReturnStatus @default(SUBMITTED)
  photoFront          String?
  photoBack           String?
  photoLeft           String?
  photoRight          String?
  photoSpeedometer    String?
  latitude            Float?
  longitude           Float?
  reason              String?
  rejectionReason     String?
  endOdometer         Int?
  damageAmountInPaise Int?
  isFeeWaived         Boolean             @default(false)
  waiverReason        String?
  waivedBy            String?
  inspectedBy         String?
  inspectedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  rider               Rider               @relation(fields: [riderId], references: [id], onDelete: Cascade)
  vehicle             Vehicle             @relation("VehicleReturns", fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([vehicleId])
  @@index([status])
  @@index([riderId, status])
  @@map("vehicle_returns")
}

model KycProfile {
  id              String    @id @default(cuid())
  riderId         String    @unique
  status          KycStatus @default(PENDING)
  profilePhoto    String?
  riderPhoto      String?
  signature       String?
  aadhaarFront    String?
  aadhaarBack     String?
  aadhaarNumber   String?
  panCard         String?
  panNumber       String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  editableFields  String[]
  rider           Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([riderId])
  @@index([status, riderId])
  @@index([updatedAt])
  @@map("kyc_profiles")
}

model Guarantor {
  id           String          @id @default(cuid())
  riderId      String          @unique
  status       GuarantorStatus @default(PENDING)
  name         String?
  relation     String?
  dob          String?
  phone        String?
  aadhaarFront String?
  aadhaarBack  String?
  pan          String?
  video        String?
  signature    String?
  address      String?
  photo        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  fatherName   String?
  motherName   String?
  rider        Rider           @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([status])
  @@map("guarantors")
}

model Wallet {
  id                     String         @id @default(cuid())
  riderId                String         @unique
  balanceInPaise         Int            @default(0)
  securityDepositInPaise Int            @default(0)
  depositStatus          DepositStatus  @default(NOT_SUBMITTED)
  paymentStreak          Int            @default(0)
  version                Int            @default(1)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  rider                  Rider          @relation(fields: [riderId], references: [id], onDelete: Restrict)
  ledgerEntries          WalletLedger[]

  @@index([riderId])
  @@index([depositStatus])
  @@map("wallets")
}

model WalletLedger {
  id             String          @id @default(cuid())
  walletId       String
  riderId        String
  transactionId  String?         @map("txnId")
  entryType      LedgerEntryType
  category       LedgerCategory
  amountInPaise  Int
  balanceAfter   Int
  idempotencyKey String?         @unique
  note           String?
  actorId        String?
  createdAt      DateTime        @default(now())
  rider          Rider           @relation(fields: [riderId], references: [id], onDelete: Restrict)
  txn            Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([riderId])
  @@index([transactionId])
  @@index([category])
  @@index([createdAt])
  @@index([riderId, createdAt])
  @@map("wallet_ledgers")
}

model DepositRecord {
  id                    String        @id @default(cuid())
  riderId               String        @unique
  transactionId         String?       @unique
  amountInPaise         Int           @default(0)
  status                DepositStatus @default(PENDING)
  paidAt                DateTime?
  approvedAt            DateTime?
  approvedBy            String?
  rejectedAt            DateTime?
  rejectedBy            String?
  rejectionReason       String?
  refundedAt            DateTime?
  refundedBy            String?
  refundedAmountInPaise Int?
  forfeitedAt           DateTime?
  forfeitedBy           String?
  forfeitReason         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  rider                 Rider         @relation(fields: [riderId], references: [id], onDelete: Restrict)
  transaction           Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([riderId])
  @@map("deposit_records")
}

model RentalLease {
  id                String       @id @default(cuid())
  vehicleId         String
  riderId           String
  shiftId           String
  leaseDate         String
  startTime         String
  endTime           String?
  status            RentalStatus @default(BOOKED)
  basePriceInPaise  Int
  finalPriceInPaise Int
  startOdometer     Int?
  startBatteryPct   Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  rider             Rider        @relation(fields: [riderId], references: [id], onDelete: Cascade)
  shift             Shift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  vehicle           Vehicle      @relation("VehicleLeases", fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, shiftId, leaseDate])
  @@index([riderId, leaseDate])
  @@index([vehicleId, leaseDate])
  @@index([status])
  @@index([riderId, status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("rental_leases")
}

model Transaction {
  id              String                 @id @default(cuid())
  riderId         String
  type            TransactionType
  amountInPaise   Int
  purpose         TransactionPurpose
  reason          String?
  method          String?
  status          TransactionStatus      @default(PENDING)
  upiRef          String?
  receipt         String?
  proofUrl        String?
  remark          String?
  description     String?
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  idempotencyKey  String?                @unique
  reversedTxnId   String?
  createdAt       DateTime               @default(now())
  depositRecord   DepositRecord?
  rider           Rider                  @relation(fields: [riderId], references: [id], onDelete: Restrict)
  breakdowns      TransactionBreakdown[]
  ledgerEntries   WalletLedger[]

  @@index([status])
  @@index([riderId])
  @@index([purpose])
  @@index([createdAt])
  @@index([idempotencyKey])
  @@index([riderId, status])
  @@index([riderId, createdAt])
  @@map("transactions")
}

model TransactionBreakdown {
  id            String        @id @default(cuid())
  transactionId String
  label         String
  amountInPaise Int
  type          BreakdownType @default(CHARGE)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("transaction_breakdowns")
}

model SupportTicket {
  id               String              @id @default(cuid())
  ticketId         String              @unique
  riderId          String
  vehicleId        String?
  category         TicketCategory
  priority         TicketPriority      @default(MEDIUM)
  subject          String
  message          String
  status           SupportTicketStatus @default(OPEN)
  troubleshootPath String?
  assignedTo       String?
  resolvedAt       DateTime?
  isEscalated      Boolean             @default(false)
  escalatedAt      DateTime?
  escalatedBy      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  attachments      String?
  rider            Rider               @relation(fields: [riderId], references: [id], onDelete: Cascade)
  vehicle          Vehicle?            @relation("VehicleTickets", fields: [vehicleId], references: [id], onDelete: Cascade)
  messages         TicketMessage[]

  @@index([status])
  @@index([riderId])
  @@index([priority])
  @@index([assignedTo])
  @@index([riderId, status])
  @@map("support_tickets")
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  senderId    String
  senderType  SenderType
  message     String
  attachments String?
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@map("ticket_messages")
}

model Notification {
  id        String               @id @default(cuid())
  riderId   String
  title     String
  message   String
  type      NotificationType
  priority  NotificationPriority @default(NORMAL)
  deepLink  String?
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())
  rider     Rider                @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([isRead])
  @@index([type])
  @@index([priority])
  @@index([riderId, isRead])
  @@index([riderId, createdAt])
  @@index([riderId, isRead, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  riderId        String
  channel        String
  status         NotificationDeliveryStatus @default(PENDING)
  sentAt         DateTime?
  deliveredAt    DateTime?
  error          String?
  createdAt      DateTime                   @default(now())

  @@index([riderId])
  @@index([status])
  @@index([notificationId])
  @@map("notification_deliveries")
}

model AuditLog {
  id        String          @id @default(cuid())
  actorId   String
  actorType ActorType       @default(ADMIN)
  action    AuditActionType
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  expiresAt DateTime?
  createdAt DateTime        @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId, action])
  @@map("audit_logs")
}

model SyncQueue {
  id         String     @id @default(cuid())
  riderId    String
  actionType String
  payload    Json
  endpoint   String
  method     HttpMethod @default(POST)
  status     SyncStatus @default(PENDING)
  retryCount Int        @default(0)
  createdAt  DateTime   @default(now())
  syncedAt   DateTime?

  @@index([riderId])
  @@index([status])
  @@map("sync_queues")
}

model FileRecord {
  id           String         @id @default(cuid())
  ownerType    FileOwnerType  @default(RIDER)
  ownerId      String
  purpose      String
  storageKey   String         @unique
  originalName String
  mimeType     String
  sizeBytes    Int            @default(0)
  checksum     String?
  visibility   FileVisibility @default(PRIVATE)
  status       FileStatus     @default(PENDING_UPLOAD)
  metadata     Json?
  createdAt    DateTime       @default(now())
  uploadedAt   DateTime?
  reviewedAt   DateTime?
  reviewedBy   String?

  @@index([ownerType, ownerId])
  @@index([ownerId])
  @@index([purpose])
  @@index([status])
  @@index([ownerId, status])
  @@index([ownerId, purpose])
  @@map("file_records")
}

model Offer {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  validFrom   DateTime
  validUntil  DateTime
  isActive    Boolean  @default(true)
  isSponsored Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("offers")
}

model Coupon {
  id                   String       @id @default(cuid())
  code                 String       @unique
  description          String
  discountType         DiscountType
  discountValueInPaise Int
  minAmount            Int?
  maxUses              Int?
  currentUses          Int          @default(0)
  validFrom            DateTime
  validUntil           DateTime
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("coupons")
}

model Reward {
  id        String   @id @default(cuid())
  riderId   String
  title     String
  points    Int
  createdAt DateTime @default(now())
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@map("rewards")
}

/// Consolidated settings store.
/// All key-value configuration — business settings, system config, feature flags,
/// backup locks, job tracking — is stored here. The older Setting model (table "settings")
/// has been merged into this model via migration.
model SystemSetting {
  id               String   @id @default(cuid())
  key              String   @unique
  value            String
  valueType        String   @default("STRING")
  category         String
  isSecret         Boolean  @default(false)
  isEditable       Boolean  @default(true)
  description      String?
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([key])
  @@map("system_settings")
}

model LegalDocument {
  id        String   @id @default(cuid())
  type      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt

  @@map("legal_documents")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model TeamLeader {
  id               String   @id @default(cuid())
  name             String
  phone            String
  email            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // PR-P3.2: back-relation for Rider.teamLeaderRef
  teamLeaderRiders Rider[]  @relation("RiderTeamLeader")

  @@map("team_leaders")
}

model Announcement {
  id              String                 @id @default(cuid())
  title           String
  message         String
  channel         String
  targetAudience  String
  targetIds       Json                   @default("[]")
  scheduledAt     DateTime?
  sentAt          DateTime?
  status          AnnouncementStatus     @default(DRAFT)
  totalRecipients Int                    @default(0)
  deliveredCount  Int                    @default(0)
  readCount       Int                    @default(0)
  createdBy       String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deliveries      AnnouncementDelivery[]

  @@map("announcements")
}

model AnnouncementDelivery {
  id             String                     @id @default(cuid())
  announcementId String
  riderId        String
  status         AnnouncementDeliveryStatus @default(PENDING)
  deliveredAt    DateTime?
