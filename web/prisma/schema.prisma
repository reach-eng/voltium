  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([enabled])
  @@index([nextRunAt])
  @@map("backup_schedules")
}

model BackupJob {
  id               String       @id @default(cuid())
  type             String
  scheduleType     String?
  status           String
  backupPath       String?
  databasePath     String?
  filesPath        String?
  manifestPath     String?
  checksumPath     String?
  sizeBytes        BigInt?
  fileCount        Int?
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdByAdminId String?
  createdAt        DateTime     @default(now())
  createdByAdmin   Admin?       @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  restoreJobs      RestoreJob[]

  @@index([status])
  @@index([type])
  @@index([scheduleType])
  @@index([createdAt])
  @@index([createdByAdminId])
  @@map("backup_jobs")
}

model RestoreJob {
  id                 String    @id @default(cuid())
  backupJobId        String
  status             String
  requestedByAdminId String
  approvedByAdminId  String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  backupJob          BackupJob @relation(fields: [backupJobId], references: [id], onDelete: Restrict)

  @@index([backupJobId])
  @@index([status])
  @@index([createdAt])
  @@map("restore_jobs")
}

model IdempotencyKey {
  id        String            @id @default(cuid())
  key       String            @unique
  response  String?
  expiresAt DateTime
  createdAt DateTime          @default(now())
  status    IdempotencyStatus @default(PROCESSING)
  // P1: forensics ordering (nullable — no backfill needed).
  updatedAt DateTime?         @updatedAt

  @@index([expiresAt])
  @@index([status])
  @@map("idempotency_keys")
}

