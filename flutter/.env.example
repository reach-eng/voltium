# Firebase configuration for the rider app
# (BLOCKER 1.3 — env-driven, no hardcoded defaults)
#
# All 9 values below are required. A missing value throws
# MissingFirebaseConfigException at app startup, naming the missing key.
#
# Where to find these:
#   1. Firebase Console (https://console.firebase.google.com)
#   2. Project Settings -> Your apps -> Android / iOS
#   3. Copy the relevant values into the matching env var below

# Android
FIREBASE_API_KEY_ANDROID=
FIREBASE_APP_ID_ANDROID=
FIREBASE_MESSAGING_SENDER_ID_ANDROID=

# iOS
FIREBASE_API_KEY_IOS=
FIREBASE_APP_ID_IOS=
FIREBASE_MESSAGING_SENDER_ID_IOS=
FIREBASE_IOS_BUNDLE_ID=com.voltiumelectric.voltium

# Shared
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# ─── Analytics (PostHog) ─────────────────────────────────────────────────────
# Get your API key from: https://app.posthog.com/project/settings
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
